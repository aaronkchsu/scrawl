# Node 24. Run npm install once, then npm run dev. No keys needed for demo mode.
PORT=4177
HOST=127.0.0.1
BASE_URL=http://localhost:4177
# Required when binding to a non-loopback address. Enter in the dashboard.
CONTROL_TOKEN=
# Separate app registration from the captions project.
# Register redirect URL: http://localhost:4177/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional. One host-triggered request creates a cave and original pixel art.
# Normal climbs and rescue practice do not call AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Persist the request ceiling across development restarts. Not a dollar budget.
AI_MAX_REQUESTS=14
AI_USAGE_FILE=.runtime/ai-usage.json
AI_TIMEOUT_MS=60000

# Hosted mode only. Leave DATABASE_URL empty for the legacy local app.
DATABASE_URL=
# At least 32 random characters. Keep stable across deploys; encrypts Twitch tokens.
TOKEN_ENCRYPTION_KEY=
MAX_ACTIVE_ROOMS=10
# Numeric Twitch user IDs allowed to enable AI for individual streamer accounts.
OPERATOR_TWITCH_IDS=
# Import prior attempt/token counts once; zero only for a genuinely new project.
AI_INITIAL_REQUESTS=13
AI_INITIAL_REPORTED=10
AI_INITIAL_INPUT_TOKENS=7327
AI_INITIAL_OUTPUT_TOKENS=20229
# Record the actual selected hosting price after deployment.
HOSTING_MONTHLY_ESTIMATE_USD=
